# Anthropic (AI chat, summaries, extraction)
ANTHROPIC_API_KEY=

# Resend (welcome emails, notifications)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=

# Cron auth (for scheduled jobs)
CRON_SECRET=

# Demo account password (for /api/admin/provision-demo — never hardcode)
DEMO_ACCOUNT_PASSWORD=

# Site URL (used in email links)
NEXT_PUBLIC_SITE_URL=https://carecompanionai.org

# Optional: Logging level (debug|info|warn|error)
LOG_LEVEL=info

# OAuth integrations (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
ONEUP_CLIENT_ID=
ONEUP_CLIENT_SECRET=

# Slow Network Simulator (development/staging only)
NEXT_PUBLIC_NETWORK_DELAY_MS=0

# NextAuth / Auth.js
AUTH_SECRET=  # openssl rand -base64 32

# Database (Aurora Postgres connection string)
DATABASE_URL=

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Upstash Redis (distributed rate limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# === Testing Infrastructure ===

# E2E test endpoint protection (required for /api/e2e/signin)
E2E_AUTH_SECRET=  # openssl rand -base64 32

# Internal analytics — salt for SHA-256(user_uuid + salt) → analytics_events.user_id_hash
# Rotate ONLY if you accept losing per-user funnel continuity. Never log.
ANALYTICS_HASH_SALT=  # openssl rand -base64 32

# Vertex AI (BAA-covered Gemini embeddings).
# Auth: Workload Identity Federation between Vercel OIDC and GCP — no JSON key.
# Local dev: `gcloud auth application-default login` (env vars below not needed).
GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# Format: //iam.googleapis.com/projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/<POOL>/providers/<PROVIDER>
GCP_WORKLOAD_AUDIENCE=
GCP_SERVICE_ACCOUNT=  # carecompanion-vertex@<project>.iam.gserviceaccount.com

# Test Mode (staging/preview only)
NEXT_PUBLIC_TEST_MODE=false

# GitHub bug report integration
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=owner/repo

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
