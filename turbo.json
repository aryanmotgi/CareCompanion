{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"],
      "env": [
        "ANTHROPIC_API_KEY",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_URL",
        "AWS_ACCESS_KEY_ID",
        "AWS_REGION",
        "AWS_RESOURCE_ARN",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SECRET_ARN",
        "COGNITO_CLIENT_ID",
        "COGNITO_CLIENT_SECRET",
        "COGNITO_DOMAIN",
        "COGNITO_REGION",
        "COGNITO_USER_POOL_ID",
        "CRON_SECRET",
        "DATABASE_NAME",
        "E2E_AUTH_SECRET",
        "GITHUB_FEEDBACK_REPO",
        "GITHUB_FEEDBACK_TOKEN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "KV_REST_API_READ_ONLY_TOKEN",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "KV_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "OAUTH_STATE_SECRET",
        "ONEUP_CLIENT_ID",
        "ONEUP_CLIENT_SECRET",
        "QA_TEST_PASSWORD",
        "REDIS_URL",
        "RESEND_API_KEY",
        "TOKEN_ENCRYPTION_KEY",
        "VAPID_PRIVATE_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test:run": {}
  }
}
